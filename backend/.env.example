APP_ENV=development
APP_NAME=KRL Forecast API
DATABASE_URL=postgresql+asyncpg://krl:change-me@db:5432/krl_forecast
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Kunci endpoint admin (header X-API-Key). Kosong/placeholder = endpoint admin NONAKTIF.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
KRL_API_KEY=
ARTIFACTS_DIR=/app/artifacts/models
FORECAST_CACHE_TTL_SECONDS=3600
INFERENCE_TIMEOUT_SECONDS=15
KRL_CAPACITY_WEEKDAY_RIBU=
KRL_CAPACITY_WEEKEND_RIBU=
KRL_RISK_WASPADA_RATIO=0.90
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=12
OLLAMA_MAX_CONCURRENCY=1
AI_INSIGHT_CACHE_TTL_SECONDS=86400
AI_INSIGHT_MAX_OUTPUT_CHARS=500
AI_INSIGHT_PROMPT_VERSION=1.0
INFERENCE_MAX_CONCURRENCY=2
# Jika diisi, manifest model wajib memuat `signature` (HMAC-SHA256 atas sha256 model.pkl).
MODEL_SIGNING_KEY=
RATE_LIMIT_PER_MINUTE=120
