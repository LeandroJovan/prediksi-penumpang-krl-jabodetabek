# Disalin ke `.env` (di root repo, sejajar docker-compose.yml). JANGAN commit file `.env`.
# Dipakai docker-compose untuk interpolasi variabel.
POSTGRES_PASSWORD=ganti-dengan-password-kuat
# Kunci endpoint admin (header X-API-Key). Kosong = admin nonaktif.
# Buat: python -c "import secrets; print(secrets.token_urlsafe(32))"
KRL_API_KEY=
